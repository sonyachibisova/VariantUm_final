# ============================================================
# ВариантУм — пример переменных окружения
# Скопируй в .env и заполни реальными значениями
# ============================================================

# ---------- Database (PostgreSQL 16) ----------
DB_HOST=postgres
DB_PORT=5432
DB_NAME=variantum
DB_USER=variantum
DB_PASSWORD=changeme_strong_password

# ---------- Redis ----------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ---------- MinIO (S3-совместимое хранилище) ----------
MINIO_ENDPOINT=http://minio:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=changeme_minio_secret
MINIO_BUCKET=variantum-files

# ---------- GigaChat ----------
# Получить ключ: https://developers.sber.ru/studio/workspaces/
GIGACHAT_API_URL=https://gigachat.devices.sberbank.ru/api/v1
GIGACHAT_AUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
GIGACHAT_CLIENT_ID=
GIGACHAT_CLIENT_SECRET=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# Основная модель (Pro) — генерация, AI-правка, валидация
GIGACHAT_MODEL=GigaChat-2-Pro
# Лёгкая модель (Lite) — анализ, очистка текста, рекомендации (в ~7.7× дешевле Pro)
GIGACHAT_MODEL_LITE=GigaChat-2-Lite
# Максимальная модель (Max) — сложные задачи по математике/физике (опционально)
GIGACHAT_MODEL_MAX=GigaChat-2-Max
GIGACHAT_TIMEOUT_SECONDS=60

# ---------- JWT ----------
# Сгенерировать: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_to_long_random_base64_string_at_least_64_bytes
JWT_ACCESS_TOKEN_TTL=604800
JWT_REFRESH_TOKEN_TTL=2592000

# ---------- Rate limit ----------
RATE_LIMIT_LLM_PER_HOUR=30
RATE_LIMIT_UPLOAD_PER_HOUR=50

# ---------- App ----------
APP_BASE_URL=http://localhost:8080
FRONTEND_BASE_URL=http://localhost:5173
APP_PROFILE=dev

# ---------- OCR (Tesseract) ----------
# Путь к tessdata с русской моделью (rus.traineddata)
TESSDATA_PREFIX=/usr/share/tesseract-ocr/4.00/tessdata/

# ---------- Логирование ----------
LOG_LEVEL=INFO
LOG_LEVEL_VARIANTUM=DEBUG
